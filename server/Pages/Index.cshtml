@page
@model IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/dist/vite.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <environment names="Production">
    <link rel="stylesheet" asp-href-include="~/dist/assets/main-*.css" />
  </environment>
</head>

<body>
  <h1 id="hello">Hello</h1>
  <p class="text-2xl text-amber-700">Some tailwind text</p>
  <p>This is from Razor: @(1 + 2)</p>
  <environment names="Development">
      <script type="module" src="/dist/ts/main.ts"></script>
  </environment>
  <environment names="Production">
    <script type="module" asp-src-include="~/dist/assets/main-*.js"></script>
  </environment>
</body>